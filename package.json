{
  "name": "@easysqlco/eslint-config",
  "version": "0.0.24",
  "description": "Shared ESLint flat config for EasySQL Node-oriented packages",
  "author": "EasySQL",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easysqlco/eslint-config.git"
  },
  "homepage": "https://github.com/easysqlco/eslint-config#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "prettier",
    "easysqlco"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check:pack": "npm pack --dry-run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "npm run lint && npm run typecheck && node ./scripts/validate-package.mjs && npm run check:pack"
  },
  "dependencies": {
    "@eslint/js": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.58.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^9.13.0",
    "prettier": "^3.8.2",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "eslint": ">= 9.7 < 10",
    "prettier": ">= 3",
    "typescript": ">= 5 < 6"
  }
}
